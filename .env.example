# ─────────────────────────────────────────────────────────────
# TripSync environment configuration
# Copy this file to `.env` and fill in your own keys, then restart
# the dev server / rebuild:  cp .env.example .env
# All keys are exposed to the browser (Vite `VITE_` prefix) — use
# keys that are safe for client-side use and domain-restricted.
# ─────────────────────────────────────────────────────────────

# Firebase — https://console.firebase.google.com → Project settings → Your apps (Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps JavaScript API — https://console.cloud.google.com
# Enable: Maps JavaScript API, Places API, Directions API, Distance Matrix API
VITE_GOOGLE_MAPS_API_KEY=

# OpenAI — https://platform.openai.com/api-keys (used for AI travel suggestions)
VITE_OPENAI_API_KEY=
